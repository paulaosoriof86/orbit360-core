rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function activeMembership(tenantId) {
      return isSignedIn()
        && exists(membershipPath(tenantId))
        && get(membershipPath(tenantId)).data.uid == request.auth.uid
        && get(membershipPath(tenantId)).data.tenantId == tenantId
        && get(membershipPath(tenantId)).data.status == 'active';
    }

    // TEMPORAL_RETIRO · compatibilidad de lectura exclusivamente para validación LAB A&S.
    function isLegacyLabValidationUser() {
      return isSignedIn()
        && request.auth.uid == 'woJlxR1iFEeiQZvTscPj4qQ5Qc73'
        && request.auth.token.email == 'orbit.lab@demo.com';
    }

    match /tenants/{tenantId}/members/{memberUid} {
      allow get: if isSignedIn() && memberUid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/system/config {
      allow read: if activeMembership(tenantId);
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/credentialRefs/{document=**} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/data/{collection}/items/{documentId} {
      allow read: if activeMembership(tenantId);
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/auditEvents/{document=**} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/importBatches/{document=**} {
      allow read, write: if false;
    }


    // TEMPORAL_RETIRO · preview LAB legado; no habilita escrituras ni otras colecciones.
    match /tenantId/{tenantId}/{collection}/{documentId} {
      allow read: if tenantId == 'alianzas-soluciones'
        && isLegacyLabValidationUser()
        && activeMembership(tenantId)
        && collection in ['clientes', 'aseguradoras', 'asesores', 'polizas', 'vehiculos', 'recibosEsperados', 'carteraPrimas', 'cobros'];
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
