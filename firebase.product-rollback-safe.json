{
  "firestore": {
    "rules": "firestore.product-deny-all.rules"
  },
  "hosting": {
    "public": "orbit360-platform/rollback-safe",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      }
    ]
  }
}
