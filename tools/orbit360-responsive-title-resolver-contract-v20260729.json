  "insurerFicha":{"scopeSelector":"#asg-ficha","expectedTextSource":"Orbit.store.get('aseguradoras', #asg-ficha.dataset.id).nombre"},
  "invalidPatterns":["global first div","source-file text proxy","tag-only h2 requirement"],
  "classification":"VALIDATOR_STALE_ROOT_CAUSE_CONTROL",
  "containsPII":false,
  "containsSecrets":false
}
