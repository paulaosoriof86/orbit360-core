.7,250.8 673.5,244.4" fill="#100E14"/><polygon points="626.2,231.8 653.7,240.8 653.7,250.8 626.2,241.8" fill="#221C2A"/><polygon points="646,225.4 673.5,234.4 653.7,240.8 626.2,231.8" fill="#3E3746"/><path d="M646,225.4 L673.5,234.4 L653.7,240.8" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".9"/><polygon points="651.5,219.6 647.1,221.1 647.1,245.1 651.5,243.6" fill="#96691B"/><polygon points="642.7,219.6 647.1,221.1 647.1,245.1 642.7,243.6" fill="#D8A94E"/><polygon points="647.1,218.2 651.5,219.6 647.1,221.1 642.7,219.6" fill="#F7E3AE"/><path d="M647.1,218.2 L651.5,219.6 L647.1,221.1" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".9"/><polygon points="665.1,212.6 648.6,218 648.6,229 665.1,223.6" fill="#A99C95"/><polygon points="624,210 648.6,218 648.6,229 624,221" fill="#D3C7BE"/><polygon points="640.5,204.6 665.1,212.6 648.6,218 624,210" fill="#F3EDE6"/><path d="M640.5,204.6 L665.1,212.6 L648.6,218" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".9"/><polygon points="679.4,213.3 662.9,218.7 662.9,233.7 679.4,228.3" fill="#780015"/><polygon points="648.6,214 662.9,218.7 662.9,233.7 648.6,229" fill="#B8001F"/><polygon points="665.1,208.6 679.4,213.3 662.9,218.7 648.6,214" fill="#F0284C"/><path d="M665.1,208.6 L679.4,213.3 L662.9,218.7" fill="none" stroke="rgba(255,255,255,.3)" stroke-width=".9"/><ellipse cx="632.8" cy="223.8" rx="4" ry="2" fill="#0A0910"/><ellipse cx="650.2" cy="229.5" rx="4" ry="2" fill="#0A0910"/></g>
                </svg>
                <sc-for list="{{ chainItems }}" as="c" hint-placeholder-count="5">
                  <span aria-hidden="true" class="vl-chainpin" style="{{ c.spot }}"><span style="{{ c.spotDot }}">{{ c.n }}</span><span style="{{ c.spotLab }}">{{ c.label }}</span></span>
                </sc-for>
              </div>
              <div style="position:relative;z-index:6;display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:0 20px 18px;">
                <div><div style="font-family:'IBM Plex Mono';font-size:9px;letter-spacing:.1em;color:#ADA69B;">LECTURA DE CONJUNTO</div><div style="font-family:'Archivo';font-weight:800;font-size:clamp(17px,1.9vw,22px);color:#fff;margin-top:3px;letter-spacing:-.015em;">{{ chainTitle }}</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3 · AMPLITUD EMPRESARIAL · NIVEL C teaser (absorbe la banda R4 “Protección empresarial”) -->
      <div style="background:#F4F1EA;color:#12110F;">
        <div class="vl-r1b-teaser" style="max-width:1600px;margin:0 auto;padding:clamp(24px,3vh,38px) clamp(20px,3vw,44px);">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;color:#C4001F;">PROTECCIÓN EMPRESARIAL</div>
          <h3 style="font-family:'Archivo';font-weight:800;font-size:clamp(19px,1.95vw,26px);letter-spacing:-.022em;line-height:1.08;margin:10px 0 0;max-width:36ch;">Protege la operación completa, no una póliza aislada.</h3>
          <p style="font-size:14px;line-height:1.6;color:#454039;margin:10px 0 0;max-width:78ch;">La cadena casi nunca viaja sola: responsabilidad, contratos, propiedad, continuidad, movilidad y beneficios se activan alrededor de la misma operación.</p>
          <div class="vl-co-groups">
            <sc-for list="{{ coGroups }}" as="g" hint-placeholder-count="4">
              <div class="vl-co-group"><span>{{ g.k }}</span><b>{{ g.t }}</b><i>{{ g.d }}</i></div>
            </sc-for>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;">
            <button onClick="{{ goEmpresas }}" style="min-height:48px;padding:0 22px;border-radius:12px;background:#E4002B;border:none;color:#fff;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;">Ir a Empresas</button>
          </div>
          <p style="font-size:11.5px;color:#6E655C;line-height:1.55;margin:14px 0 0;max-width:80ch;" class="vl-functional-mobile">Cada grupo tiene sus propios criterios y condiciones; esa revisión se hace en Empresas. Que una solución exista en el mercado no significa que sea adecuada o esté disponible para todos los casos.</p>
        </div>
      </div>

      <!-- 4 · PERSONAS Y FAMILIAS · NIVEL C teaser secundario -->
      <div style="background:#EFE9DD;color:#12110F;">
        <div class="vl-split" style="max-width:1600px;margin:0 auto;padding:clamp(24px,3vh,38px) clamp(20px,3vw,44px);display:grid;grid-template-columns:1fr .9fr;gap:clamp(18px,2.4vw,34px);align-items:center;">
          <div style="min-width:0;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;color:#C4001F;">PERSONAS Y FAMILIAS</div>
            <h3 style="font-family:'Archivo';font-weight:800;font-size:clamp(19px,1.95vw,26px);letter-spacing:-.022em;line-height:1.08;margin:10px 0 0;max-width:24ch;">Tu protección también cambia con tu vida.</h3>
            <p style="font-size:14px;line-height:1.6;color:#454039;margin:10px 0 0;max-width:58ch;">Movilidad, hogar, salud, vida e ingreso se conectan de forma distinta según tu momento. Una póliza de salud es un seguro privado según sus condiciones; no es una EPS.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;min-width:0;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <sc-for list="{{ coPersonas }}" as="p" hint-placeholder-count="4"><span style="font-size:13px;font-weight:600;padding:8px 14px;border-radius:999px;background:#fff;border:1px solid #E2DACF;color:#12110F;">{{ p.t }}</span></sc-for>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;">
              <button onClick="{{ goPersonas }}" style="min-height:48px;padding:0 22px;border-radius:12px;background:#E4002B;border:none;color:#fff;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;">Explorar mi protección</button>
            </div>
          </div>
        </div>
      </div>

      <!-- 5 · MÉTODO + CONTINUIDAD · compactado (F7-CIG-05-R1B) -->
      <div style="background:#171419;color:#F4F1EA;">
        <div style="max-width:1600px;margin:0 auto;padding:clamp(26px,3.2vh,42px) clamp(20px,3vw,44px);">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;color:#FF7C8C;">MÉTODO A&amp;S</div>
          <h3 style="font-family:'Archivo';font-weight:800;font-size:clamp(19px,1.95vw,26px);letter-spacing:-.022em;line-height:1.08;margin:10px 0 0;max-width:30ch;">Comparar empieza antes del precio.</h3>
          <div class="vl-3" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px;">
            <sc-for list="{{ coMetodo }}" as="m" hint-placeholder-count="4">
              <div style="border-top:2px solid #E4002B;padding-top:12px;display:flex;flex-direction:column;gap:5px;min-width:0;">
                <span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.14em;color:#FF9DA8;">{{ m.n }}</span>
                <span style="font-family:'Archivo';font-weight:800;font-size:18px;letter-spacing:-.02em;color:#fff;line-height:1.1;">{{ m.t }}</span>
              </div>
            </sc-for>
          </div>
          <div class="vl-split" style="display:grid;grid-template-columns:1fr .9fr;gap:clamp(18px,2.4vw,32px);margin-top:22px;border-top:1px solid #2a2833;padding-top:18px;align-items:start;">
            <div style="min-width:0;">
              <p style="font-size:14px;line-height:1.6;color:#CFC9BE;margin:0;max-width:70ch;"><b style="color:#fff;">Recibida no significa validada.</b> Solo una propuesta validada y vigente entra a la comparación. Cuando una alternativa no informa un dato, se muestra como dato no informado: no como “no cubre”. Elegir no equivale a emisión.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;">
                <button onClick="{{ goCotComp }}" style="min-height:48px;padding:0 22px;border-radius:12px;background:#E4002B;border:none;color:#fff;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;">Cotizar o comparar</button>
                <button onClick="{{ goRenovar }}" style="min-height:48px;padding:0 20px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.24);color:#fff;font-family:inherit;font-weight:600;font-size:14px;cursor:pointer;">Revisar antes de renovar</button>
              </div>
            </div>
            <div style="display:grid;gap:10px;min-width:0;align-content:start;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.12em;color:#A9A29A;">CONTINÚA POR DONDE NECESITES</div>
              <div style="display:flex;gap:9px;flex-wrap:wrap;">
                <sc-for list="{{ coNext }}" as="nx" hint-placeholder-count="4">
                  <button onClick="{{ nx.go }}" class="vl-co-allbtn">{{ nx.t }}</button>
                </sc-for>
              </div>
              <p style="font-size:11.5px;line-height:1.55;color:#A9A29A;margin:4px 0 0;" class="vl-functional-mobile">Puedes continuar en línea solo cuando el caso es elegible. Pagos, emisión y Mi Portal solo se muestran cuando están disponibles.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 6 · SINIESTROS, SERVICIO Y CONTINUIDAD · NIVEL D banda utilitaria (fusión R4 bandas 7+8) -->
      <div style="background:#F4F1EA;color:#12110F;">
        <div style="max-width:1600px;margin:0 auto;padding:clamp(26px,3.2vh,42px) clamp(20px,3vw,44px);">
          <div class="vl-split" style="display:grid;grid-template-columns:.86fr 1.14fr;gap:clamp(18px,2.4vw,34px);align-items:start;">
            <div style="min-width:0;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.14em;color:#C4001F;">SINIESTROS, SERVICIO Y CONTINUIDAD</div>
              <h3 style="font-family:'Archivo';font-weight:800;font-size:clamp(19px,1.95vw,26px);letter-spacing:-.022em;line-height:1.08;margin:10px 0 0;max-width:26ch;">Si algo ocurrió, te ayudamos a ordenar el siguiente paso.</h3>
              <p style="font-size:14px;line-height:1.6;color:#454039;margin:10px 0 0;max-width:56ch;">Seguridad primero. Luego identificamos si necesitas asistencia, aviso, radicación o seguimiento y te dirigimos al canal oficial que corresponde.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;">
                <button onClick="{{ goSiniestros }}" style="min-height:48px;padding:0 22px;border-radius:12px;background:#E4002B;border:none;color:#fff;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;">Necesito orientación ahora</button>
                <button onClick="{{ openHandoff }}" style="min-height:48px;padding:0 20px;border-radius:12px;background:#fff;border:1.5px solid #CFC5B4;color:#12110F;font-family:inherit;font-weight:600;font-size:14px;cursor:pointer;">Cuéntanos qué necesitas proteger</button>
              </div>
              <p style="font-size:11.5px;color:#6E655C;line-height:1.55;margin:14px 0 0;max-width:64ch;" class="vl-functional-mobile">A&amp;S acompaña; la aseguradora o el proveedor conserva la decisión sobre asistencia, cobertura, ajuste e indemnización.</p>
            </div>
            <div style="min-width:0;">
              <div class="vl-3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;">
                <sc-for list="{{ coServicio }}" as="sv" hint-placeholder-count="3">
                  <button onClick="{{ sv.go }}" style="text-align:left;font-family:inherit;cursor:pointer;background:#fff;border:1px solid #E2DACF;border-radius:14px;padding:16px;min-height:104px;display:flex;flex-direction:column;gap:5px;transition:border-color .16s,transform .16s;" style-hover="border-color:#E4002B;transform:translateY(-2px);">
                    <span style="font-family:'Archivo';font-weight:700;font-size:15.5px;color:#12110F;line-height:1.14;">{{ sv.t }}</span>
                    <span style="font-size:12.5px;line-height:1.5;color:#454039;">{{ sv.d }}</span>
                    <span style="margin-top:auto;padding-top:8px;font-family:'Archivo';font-weight:700;font-size:13px;color:#C4001F;">{{ sv.cta }} →</span>
                  </button>
                </sc-for>
              </div>
              <p style="font-size:11.5px;color:#6E655C;line-height:1.55;margin:12px 0 0;max-width:80ch;" class="vl-functional-mobile">A&amp;S Consultores de Seguros — intermediación de seguros en Colombia. No trabajamos con todas las aseguradoras del mercado ni prometemos el mejor precio.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;">
                <button onClick="{{ goSobre }}" style="min-height:48px;padding:0 20px;border-radius:12px;background:#fff;border:1.5px solid #E7E2D6;color:#12110F;font-family:inherit;font-weight:600;font-size:14px;cursor:pointer;">Conocer cómo trabajamos</button>
              </div>
            </div>
          </div>
        </div>
      </div>


    </section>
  </sc-if>

  <!-- ============================ EMPRESAS GT ============================ -->
  <sc-if value="{{ isEmpresas }}" hint-placeholder-val="{{ false }}">
    <section class="vl-screen" data-screen-label="Empresas" data-country="{{ empCountryCode }}">

      <!-- HERO · composición tipográfica + seis dominios condensados (sin fotografía) -->
      <div style="position:relative;background:#0E0D10;color:#F4F1EA;overflow:hidden;">
        <div aria-hidden="true" style="position:absolute;inset:0;z-index:0;background:radial-gradient(980px 600px at 88% 2%,rgba(228,0,43,.15),transparent 62%);"></div>
        <div class="vl-hero-grid vl-emp-hero" style="position:relative;z-index:1;max-width:1600px;margin:0 auto;padding:clamp(44px,7vh,98px) clamp(20px,3vw,44px);display:grid;grid-template-columns:1.06fr 1fr;gap:clamp(24px,3.2vw,52px);align-items:center;">
          <div style="min-width:0;">
            <div style="font-family:'IBM Plex Mono';font-size:12px;letter-spacing:.14em;color:#FF7C8C;display:flex;align-items:center;gap:10px;"><span style="width:30px;height:2px;background:#E4002B;"></span>{{ empEyebrow }}</div>
            <h1 style="font-family:'Archivo';font-weight:900;font-size:clamp(34px,4.4vw,72px);line-height:.95;letter-spacing:-.035em;margin:18px 0 0;max-width:20ch;">{{ empH1a }}<span style="color:#FF3B54;">{{ empH1b }}</span>{{ empH1c }}</h1>
            <p style="font-family:'Instrument Sans',system-ui,sans-serif;font-size:clamp(17px,1.55vw,22px);line-height:1.45;color:#D7D1C4;margin:18px 0 0;max-width:54ch;">{{ empBody }}</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;">
              <button onClick="{{ empScroll }}" style="min-height:52px;padding:0 24px;border-radius:13px;background:#E4002B;border:none;color:#fff;font-family:inherit;font-weight:700;font-size:15px;cursor:pointer;">{{ empCta }}</button>
              <button onClick="{{ openHandoff }}" style="min-height:52px;padding:0 24px;border-radius:13px;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.24);color:#fff;font-family:inherit;font-weight:600;font-size:15px;cursor:pointer;">Hablar con un asesor</button>
            </div>
            <p style="font-size:12px;line-height:1.55;color:#A9A29A;margin:24px 0 0;max-width:60ch;border-top:1px solid #2a2833;padding-top:14px;">{{ empTruth }}</p>
          </div>
          <sc-if value="{{ empCoHeroShow }}" hint-placeholder-val="{{ false }}">
            <figure class="vl-emp-heromedia" style="margin:0;position:relative;border-radius:24px;overflow:hidden;border:1px solid #2a2833;box-shadow:0 54px 112px -62px rgba(0,0,0,.95);">
              <img src="assets/library_real/ECO_H03_REUNION_CORPORATIVA_CO_REAL_v1.png" alt="{{ empCoHeroAlt }}" decoding="async" style="display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:52% 48%;">
              <span aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,13,16,0) 56%,rgba(14,13,16,.66) 100%);"></span>
              
            </figure>
          </sc-if>
          <div class="vl-emp-heropanel" style="min-width:0;border:1px solid #2a2833;border-radius:22px;background:linear-gradient(155deg,#1a1119 0%,#0E0D10 62%);padding:clamp(18px,2vw,26px);box-shadow:0 46px 96px -58px rgba(0,0,0,.9);">
            <div style="font-family:'IBM Plex Mono';font-size:10px;letter-spacing:.12em;color:#FF9DA8;">{{ empPanelLabel }}</div>
            <div class="vl-2 vl-egt-areas" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;">
              <sc-for list="{{ empDominios }}" as="d" hint-placeholder-count="6">
                <div style="border-top:2px solid rgba(228,0,43,.7);padding:10px 0 0;display:flex;flex-direction:column;gap:3px;">
                  <span class="vl-co-num" style="font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;color:#FF9DA8;">{{ d.n }}</span>
                  <span style="font-family:'Archivo';font-weight:700;font-size:14.5px;color:#fff;">{{ d.t }}</span>
                  <span style="font-size:12px;line-height:1.45;color:#CFC9BE;">{{ d.d }}</span>
                </div>
              </sc-for>
            </div>
            <sc-if value="{{ empPanelNoteShow }}" hint-placeholder-val="{{ false }}">
              <p class="vl-functional-mobile" style="font-size:11.5px;line-height:1.55;color:#A9A29A;margin:16px 0 0;">{{ empPanelNote }}</p>
            </sc-if>
            <sc-if value="{{ empCoPreflightShow }}" hint-placeholder-val="{{ false }}">
              <div class="vl-co-anchor" style="margin:18px 0 0;border-top:1px solid #2a2833;padding-top:16px;">
                <div aria-hidden="true" style="height:118px;border-radius:12px;border:1px dashed #4a4550;background:repeating-linear-gradient(135deg,#1A1820 0 12px,#141216 12px 24px);display:grid;place-items:center;text-align:center;padding:0 16px;">
                  <span style="font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;line-height:1.7;color:#A9A29A;">NON_PUBLIC_PREFLIGHT<br>SLOT DE EQUIPO A&amp;S COLOMBIA · SIN ACTIVO APROBADO</span>
                </div>
              </div>
            </sc-if>
            <sc-if value="{{ empHumanShow }}" hint-placeholder-val="{{ false }}">
              <div class="vl-egt-anchor">
                <img src="assets/library_real/EGT_C01_REUNION_EMPRESARIAL_REAL_v1.png" alt="Reunión empresarial de A&amp;S para revisar alternativas y riesgos de una operación." loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;object-position:50% 50%;">
              </div>
            </sc-if>
          </div>
        </div>
      </div>

      <!-- F7-T3A · SITUACIÓN · punto de partida compacto entre hero y mapa (solo Guatemala) -->
      <sc-if value="{{ empSitShow }}" hint-placeholder-val="{{ false }}">
        <div id="vl-emp-situacion" style="background:#EFE9DD;color:#12110F;border-top:1px solid #E2DACF;">
          <div style="max-width:1600px;margin:0 auto;padding:clamp(24px,3.2vh,42px) clamp(20px,3vw,44px);">
            <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;">
              <div style="max-width:70ch;min-width:0;">
                <div style="font-family:'IBM Plex Mono';font-size:11px;letter-spacing:.13em;color:#C4001F;">PUNTO DE PARTIDA</div>
                <h2 style="font-family:'Archivo';font-weight:800;font-size:clamp(22px,2.5vw,33px);letter-spacing:-.024em;line-height:1.06;margin:10px 0 8px;">Empieza por lo que puede afectar tu empresa.</h2>
                <p style="font-size:14.5px;line-height:1.6;color:#454039;margin:0;">No necesitas saber el nombre de una póliza. Cuéntanos qué quieres proteger o qué cambió en tu operación y te orientamos hacia el siguiente paso.</p>
              </div>
              <sc-if value="{{ empSitAny }}" hint-placeholder-val="{{ false }}">
                <button onClick="{{ empSitClear }}" style="min-height:44px;padding:0 16px;border-radius:12px;background:#fff;border:1px solid #E2DACF;color:#454039;font-family:inherit;font-weight:600;font-size:13px;cursor:pointer;">Quitar la situación</button>
              </sc-if>
            </div>
            <div role="group" aria-label="Situación de tu empresa" class="vl-emp-sit" style="margin-top:16px;">
              <sc-for list="{{ empSituations }}" as="q" hint-placeholder-count="4">
                <button class="vl-emp-sit-card" onClick="{{ q.pick }}" aria-pressed="{{ q.active }}" data-analytics-action="situation_selected" style="{{ q.style }}">
                  <span class="vl-emp-sit-meta"><span class="vl-emp-sit-n">{{ q.n }}</span><span class="vl-emp-sit-line" aria-hidden="true"></span><span class="vl-emp-sit-status">{{ q.mark }}</span></span>
                  <span class="vl-emp-sit-title">{{ q.label }}</span>
                  <span class="vl-emp-sit-desc">{{ q.desc }}</span>
                  <span class="vl-emp-sit-arrow" aria-hidden="true">→</span>
                </button>
              </sc-for>
            </div>
            <sc-if value="{{ empSitAny }}" hint-placeholder-val="{{ false }}">
              <div aria-live="polite" style="margin-top:14px;background:#fff;border:1px solid #E7E2D6;border-radius:18px;padding:clamp(16px,1.9vw,24px);box-shadow:0 22px 52px -46px rgba(30,10,0,.45);">
                <div style="font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;color:#6E655C;">CÓMO SEGUIMOS DESDE AQUÍ</div>
                <p class="vl-emp-rail" style="font-family:'Instrument Sans',system-ui,sans-serif;font-size:15.5px;line-height:1.5;color:#3C382F;margin:6px 0 0;max-width:92ch;">{{ empSitNote }}</p>
                <sc-if value="{{ empPathShow }}" hint-placeholder-val="{{ false }}">
                  <div style="margin-top:16px;border-top:1px solid #E7E2D6;padding-top:14px;">
                    <div style="font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;color:#C4001F;">REVISIÓN DEL PROGRAMA · SECUENCIA</div>
                    <div role="group" aria-label="Secuencia de revisión del programa" class="vl-emp-path vl-emp-rail" style="margin-top:10px;">
                      <sc-for list="{{ empPathSteps }}" as="p" hint-placeholder-count="5">
                        <button onClick="{{ p.pick }}" aria-pressed="{{ p.active }}" data-analytics-action="diagnostic_step_completed" style="{{ p.style }}">
                          <span style="display:block;font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.1em;color:#C4001F;">{{ p.n }}</span>
                          <span style="display:block;font-family:'Archivo';font-weight:750;font-size:13px;letter-spacing:-.01em;margin-top:4px;">{{ p.label }}</span>
                        </button>
                      </sc-for>
                    </div>
                    <p class="vl-emp-rail" style="font-size:13.5px;line-height:1.6;color:#454039;margin:12px 0 0;max-width:92ch;">{{ empPathDesc }}</p>
                    <p class="vl-emp-rail vl-functional-copy" style="font-size:11.5px;line-height:1.55;color:#6E655C;margin:10px 0 0;max-width:92ch;">Tener varias pólizas no asegura por sí solo que el programa esté coordinado. La revisión conjunta ayuda a identificar posibles vacíos, solapamientos, diferencias de límites y vigencias antes de decidir qué conviene mantener, ajustar o comparar.</p>
                  </div>
                </sc-if>
                <div class="vl-emp-rail" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;">