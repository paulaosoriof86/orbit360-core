          f('coberturaObjetivo','Enfoque de cobertura','select',['Cobertura amplia','Daños a terceros / RC','Robo','Revisar opciones disponibles'],'Cobertura amplia','Aplicabilidad','La ruta final depende de los productos habilitados.'),
          f('formaPago','Preferencia de pago','select',['Contado','Cuotas / fraccionamiento','Revisar opciones'],'Contado','Aplicabilidad','La fuente define recargos, cuotas y mecanismos permitidos.')
        ]},
        {title:'Qué pesa más en tu decisión',kicker:'PRIORIDAD',fields:[
          f('prioridad','Prioridad principal','select',PRIORITIES.auto,'Balance costo/protección','Prioridad','Alimenta la explicación del comparador, no un ranking universal.')
        ]}
      ]
    };
  }

  function commonHealth(country){
    const gt=country==='gt';
    return {
      schemaId:`${country}_salud_audit_union_v0.2`,
      title:gt?'Gastos Médicos · composición y opciones':'Seguro / Póliza de Salud privado · contexto inicial',
      evidence:gt?'Auditoría GT: BAM Salud y Aseguradora Rural/Banrural Gastos Médicos.':'No existe rater CO público certificado en este corte; no reemplaza EPS.',
      eligibility:gt?'HYBRID_REQUIRED':'CONSULTATIVE_REQUIRED',
      sourceMode:gt?'audit-derived / backend-binding pending':'public-intake / source-binding not certified',
      groups:[
        {title:'Composición',kicker:'ASEGURADOS',fields:[
          f('modalidad','Modalidad','select',['Individual','Familiar'],'Familiar','Composición','Las fuentes GT auditadas distinguen composición individual/familiar.'),
          f('titularDob','Fecha de nacimiento del titular','date',[],'1988-05-12','Composición','La fecha exacta evita aproximaciones al validar la solicitud.'),
          f('generoTitular','Género tarifario titular','select',['Femenino','Masculino'],'Femenino','Composición','Se conserva porque aparece en matrices tarifarias auditadas; la fuente final gobierna su uso.'),
          f('conyuge','¿Incluye cónyuge?','select',['No','Sí'],'Sí','Composición','Activa datos adicionales en el backend cuando corresponda.'),
          f('spouseDob','Fecha de nacimiento del cónyuge','date',[],'1986-09-21','Composición','Completar solo si incluyes cónyuge.'),
          f('hijos','Cantidad de hijos','number',[],'1','Composición','La composición modifica plan/tarifa en fuentes auditadas.')
        ]},
        {title:'Opciones del plan',kicker:'COBERTURAS',fields:[
          f('maternidad','Maternidad','select',['No','Sí / revisar aplicabilidad'],'No','Opciones','En fuentes GT puede ser matriz alternativa por plan, no un recargo genérico.'),
          f('dental','Dental','select',['No','Sí'],'No','Opciones','Puede ser cargo individual o familiar según fuente.'),
          f('territorio','Territorio','select',gt?['Guatemala','Guatemala + internacional','Revisar territorio']:['Colombia','Colombia + internacional','Revisar territorio'],gt?'Guatemala':'Colombia','Opciones','El producto/fuente final define red y territorio.'),
          f('prioridad','Prioridad principal','select',PRIORITIES.salud,gt?'Red / acceso':'Red / acceso','Opciones','En Colombia se trata de seguro privado y no sustituye EPS.')
        ]}
      ]
    };
  }

