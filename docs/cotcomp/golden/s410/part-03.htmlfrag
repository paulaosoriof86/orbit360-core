  function schema(country,product,form){
    country=(country||'gt').toLowerCase(); product=product||'auto'; form=form||{};
    let out=product==='auto'?commonAuto(country):product==='salud'?commonHealth(country):(SIMPLE[product]?SIMPLE[product](country):SIMPLE.duda(country));
    out=JSON.parse(JSON.stringify(out));
    if(product==='salud' && out.groups && out.groups[0]){
      const comp=out.groups[0];
      const childCount=Math.max(0,Math.min(6,parseInt((form&&form.hijos)!=null?form.hijos:((comp.fields.find(x=>x.id==='hijos')||{}).default||0),10)||0));
      const idx=comp.fields.findIndex(x=>x.id==='hijos');
      const childFields=[];
      for(let i=0;i<childCount;i++) childFields.push(f('dependentDob'+(i+1),'Fecha de nacimiento · hijo '+(i+1),'date',[],i===0?'2018-06-10':'','Composición','Solo si aplica a esta composición familiar.'));
      if(idx>=0) comp.fields.splice(idx+1,0,...childFields);
    }
    out.country=country; out.product=product; out.currency=country==='co'?'COP':'GTQ';
    out.backendDimensions={pais:country.toUpperCase(),moneda:out.currency,ramo:product==='auto'?'Auto':product==='salud'?'Salud':product,producto:product};
    return out;
  }

  function flatten(schemaObj){ return (schemaObj.groups||[]).flatMap(g=>(g.fields||[])); }
  function requiredMissing(schemaObj,form){
    const missing=[];
    flatten(schemaObj).forEach(x=>{
      if(x.when && !x.when(form||{})) return;
      const v=(form||{})[x.id];
      if(v==null || String(v).trim()==='') missing.push(x.id);
    });
    return missing;
  }

  function eligibility(country,product,form){
    const sc=schema(country,product,form); const missing=requiredMissing(sc,form||{});
    let state=sc.eligibility;
    if(missing.length>3 && product!=='duda') state='MORE_DATA_REQUIRED';
    const mode=state==='AUTO_ELIGIBLE'?'DIGITAL':state==='HYBRID_REQUIRED'?'HYBRID':state==='MORE_DATA_REQUIRED'?'MORE_DATA':'CONSULTATIVE';
    return {state,mode,missing,schemaId:sc.schemaId,sourceMode:sc.sourceMode,dimensions:sc.backendDimensions};
  }

