.s41-stage-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;border-bottom:1px solid #E7E2D6;padding-bottom:15px}.s41-stage-head>div:first-child{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.s41-stage-head span{font-family:'IBM Plex Mono';font-size:10px;letter-spacing:.1em;color:#C4001F}.s41-stage-head strong{font-family:'Archivo';font-size:18px;color:#12110F}.s41-micro{font-size:12px;color:#5E594F;background:#F4F1EA;border:1px solid #E7E2D6;border-radius:999px;padding:7px 11px}.s41-summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.s41-summary-grid>div{background:#fff;border:1px solid #E7E2D6;border-radius:12px;padding:14px}.s41-summary-grid span{display:block;font-size:10px;color:#756E64;margin-bottom:4px}.s41-summary-grid strong{font-family:'Archivo';font-size:14px;color:#12110F}.s41-form-grid select,.s41-form-grid input{outline:none;transition:border-color .15s,box-shadow .15s}.s41-form-grid select:focus,.s41-form-grid input:focus{border-color:#E4002B!important;box-shadow:0 0 0 3px rgba(228,0,43,.10)}.s41-catalog-note{margin-top:12px;padding:10px 12px;border-radius:10px;background:#EEE9DF;color:#665F55;font-size:10.5px;line-height:1.45}.s41-progress-card{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #E7E2D6;border-radius:14px;padding:17px}.s41-spinner{width:24px;height:24px;border-radius:50%;border:2.5px solid #E7E2D6;border-top-color:#E4002B;flex-shrink:0}.s41-progress-card strong{font-family:'Archivo';font-size:16px;color:#12110F}.s41-progress-card p{font-size:12.5px;line-height:1.5;color:#454039;margin:5px 0}.s41-progress-card small{font-family:'IBM Plex Mono';font-size:9.5px;color:#756E64}.s41-proposal-card{background:#fff;border:1px solid #E7E2D6;border-radius:14px;padding:18px}.s41-proposal-card>div{font-weight:700;font-family:'Archivo'}.s41-proposal-card span{display:inline-flex;margin-top:8px;font-family:'IBM Plex Mono';font-size:10px;padding:3px 8px;border-radius:6px}.s41-ok{background:rgba(44,90,58,.1);color:#2C5A3A;border:1px solid rgba(44,90,58,.35)}.s41-warn{background:rgba(176,131,20,.14);color:#8a5a12;border:1px solid rgba(176,131,20,.4)}@media(max-width:760px){.s41-summary-grid{grid-template-columns:1fr}.s41-form-grid{grid-template-columns:1fr!important}.vl-wsurf-rail{display:none!important}.vl-wsurf-body{grid-template-columns:1fr!important}}
