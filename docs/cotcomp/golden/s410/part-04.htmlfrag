<style id="f7-s4-2-cotcomp-hierarchy-adapter">
.s42-wrap{max-width:1240px;margin:0 auto;padding:clamp(34px,5vh,66px) clamp(20px,3vw,44px)}
.s42-kicker{font-family:'IBM Plex Mono';font-size:11px;letter-spacing:.14em;color:#C4001F;display:flex;align-items:center;gap:10px}.s42-kicker>span{width:30px;height:2px;background:#E4002B}
.s42-hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.65fr);gap:36px;align-items:end;margin-top:14px}.s42-hero h1{font-family:'Archivo';font-weight:900;font-size:clamp(34px,4.7vw,66px);line-height:.93;letter-spacing:-.04em;margin:0;max-width:16ch}.s42-hero>div:first-child>p{font-size:15px;line-height:1.62;color:#4E4841;max-width:64ch;margin:18px 0 0}.s42-engine-card{background:#0E0D10;color:#F4F1EA;border-radius:20px;padding:20px 22px;box-shadow:0 26px 56px -40px #000}.s42-engine-top{display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;color:#FF9DA8}.s42-live-dot{width:8px;height:8px;border-radius:50%;background:#E4002B;box-shadow:0 0 0 5px rgba(228,0,43,.13)}.s42-engine-card>strong{display:block;font-family:'Archivo';font-size:20px;margin-top:14px}.s42-engine-card>p{font-size:12.5px;line-height:1.5;color:#CFC9BE;margin:6px 0 0}.s42-engine-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}.s42-engine-meta span{font-family:'IBM Plex Mono';font-size:9px;color:#D6D0C8;border:1px solid #35313A;background:#19171C;border-radius:999px;padding:5px 8px}
.s42-shell{display:grid;grid-template-columns:220px minmax(0,1fr);margin-top:30px;border-radius:26px;overflow:hidden;background:#0E0D10;box-shadow:0 44px 92px -56px rgba(0,0,0,.88)}.s42-rail{background:#141216;padding:24px 18px;color:#EDE8DE;display:flex;flex-direction:column;gap:8px}.s42-rail-title{font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.14em;color:#837B74;margin:0 10px 8px}.s42-rail-item{display:flex;align-items:center;gap:11px;padding:13px 12px;border-radius:14px;color:#8E8780;border:1px solid transparent}.s42-rail-item>span{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:#201E24;font-family:'IBM Plex Mono';font-size:11px}.s42-rail-item b{font-size:13px}.s42-rail-item.is-current{background:#fff;color:#12110F;border-color:#fff;box-shadow:0 18px 28px -24px #000}.s42-rail-item.is-current>span{background:var(--s42-accent);color:#fff}.s42-rail-item.is-done{color:#CFC9BE}.s42-rail-item.is-done>span{background:rgba(72,124,87,.2);color:#92C2A1;border:1px solid rgba(101,155,116,.35)}.s42-rail-truth{margin-top:auto;padding:14px 12px;border-top:1px solid #2A2730;display:grid;gap:6px}.s42-rail-truth b{font-family:'IBM Plex Mono';font-size:9px;letter-spacing:.1em;color:#FF9DA8}.s42-rail-truth span{font-size:11px;line-height:1.5;color:#99918B}
.s42-stage{background:#fff;min-width:0}.s42-stage-banner{background:linear-gradient(115deg,var(--s42-deep),#151318 72%);color:#fff;display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;padding:24px 28px;border-bottom:1px solid #29252D}.s42-stage-number{font-family:'Archivo';font-weight:900;font-size:58px;line-height:.8;color:var(--s42-accent);opacity:.95}.s42-stage-copy>span{font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.13em;color:#FF9DA8}.s42-stage-copy h2{font-family:'Archivo';font-size:23px;line-height:1.05;margin:5px 0 3px}.s42-stage-copy p{font-size:12px;line-height:1.45;color:#CFC9BE;margin:0}.s42-stage-context{display:flex;flex-direction:column;gap:6px;align-items:flex-end}.s42-stage-context span{font-family:'IBM Plex Mono';font-size:9px;color:#D8D2CA;border:1px solid #39333B;border-radius:999px;padding:5px 8px;white-space:nowrap}.s42-stage-body{padding:26px;background:#F8F5EF}.s42-country-note{font-size:11.5px;line-height:1.5;color:#6E5B35;background:#FFF7EA;border:1px solid #EBCFA7;border-radius:12px;padding:10px 13px;margin-bottom:18px}.s42-section-head>span{font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.12em;color:#C4001F}.s42-section-head h3{font-family:'Archivo';font-weight:850;font-size:clamp(22px,2.2vw,30px);line-height:1.05;letter-spacing:-.025em;margin:7px 0 6px;color:#12110F}.s42-section-head p{font-size:13px;line-height:1.55;color:#514A43;margin:0;max-width:74ch}
.s42-route-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}.s42-route{text-align:left;min-height:108px;padding:16px;border-radius:16px;background:#fff;border:1px solid #DDD5C9;display:flex;gap:12px;align-items:flex-start;font-family:inherit;cursor:pointer;transition:.16s;box-shadow:0 14px 30px -28px rgba(30,10,0,.6)}.s42-route:hover{transform:translateY(-2px);border-color:#BFB3A3}.s42-route.is-active{border:2px solid #E4002B;background:#FFF7F8;box-shadow:0 20px 36px -28px rgba(196,0,31,.72)}.s42-route-icon{width:38px;height:38px;border-radius:12px;background:#F4E8E9;color:#C4001F;display:grid;place-items:center;flex-shrink:0}.s42-route b{display:block;font-family:'Archivo';font-size:14px;color:#12110F}.s42-route small{display:block;font-size:11.5px;line-height:1.4;color:#6B645C;margin-top:5px}.s42-resolution-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.s42-resolution-grid>div{background:#171419;color:#F4F1EA;border-radius:14px;padding:14px}.s42-resolution-grid span{font-size:9.5px;color:#99918B;display:block}.s42-resolution-grid strong{font-family:'Archivo';font-size:12.5px;display:block;margin-top:4px;overflow-wrap:anywhere}
.s42-contract-strip{display:grid;grid-template-columns:.55fr 1.45fr 1fr;gap:10px;margin-top:18px}.s42-contract-strip>div{background:#171419;color:#fff;border-radius:13px;padding:13px}.s42-contract-strip span{display:block;font-size:9.5px;color:#99918B}.s42-contract-strip b{display:block;margin-top:4px;font-family:'IBM Plex Mono';font-size:10.5px;overflow-wrap:anywhere}.s42-form-groups{display:grid;gap:14px;margin-top:16px}.s42-form-group{background:#fff;border:1px solid #DDD5C9;border-radius:18px;padding:18px;box-shadow:0 18px 34px -34px #5C4B3B}.s42-group-head{display:flex;align-items:center;gap:12px;padding-bottom:13px;border-bottom:1px solid #E7E2D6}.s42-group-head>span{width:36px;height:36px;border-radius:11px;background:var(--s42-deep);color:#fff;display:grid;place-items:center;font-family:'IBM Plex Mono';font-size:10px}.s42-group-head small{font-family:'IBM Plex Mono';font-size:9px;color:#C4001F;letter-spacing:.1em}.s42-group-head h4{font-family:'Archivo';font-size:17px;margin:2px 0 0}.s42-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:15px}.s42-field label{display:block;font-size:11.5px;font-weight:600;color:#3D3832;margin-bottom:6px}.s42-field select,.s42-field input{width:100%;min-height:46px;border:1px solid #D3CABF;border-radius:11px;background:#fff;color:#12110F;padding:0 13px;font:inherit;font-size:13.5px;outline:none}.s42-field select:focus,.s42-field input:focus{border-color:#E4002B;box-shadow:0 0 0 3px rgba(228,0,43,.08)}.s42-field>small{display:block;font-size:9.8px;line-height:1.4;color:#7A7269;margin-top:5px}.s42-dimensions{margin-top:14px;background:#ECE7DE;border-radius:13px;padding:12px}.s42-dimensions>span{font-family:'IBM Plex Mono';font-size:9px;letter-spacing:.1em;color:#6E655C}.s42-dimensions>div{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.s42-dimensions i{font-style:normal;font-size:10.5px;background:#fff;border:1px solid #DDD5C9;border-radius:999px;padding:5px 8px;color:#5B544B}.s42-dimensions b{color:#12110F}
.s42-pipeline{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:20px}.s42-pipeline>div{position:relative;background:#ECE7DE;border:1px solid #DDD5C9;border-radius:15px;padding:14px;min-height:100px}.s42-pipeline>div>span{width:26px;height:26px;border-radius:9px;background:#D8D0C5;display:grid;place-items:center;font-family:'IBM Plex Mono';font-size:10px}.s42-pipeline b{display:block;font-family:'Archivo';font-size:13px;margin-top:12px}.s42-pipeline small{display:block;font-size:9.5px;line-height:1.35;color:#746C63;margin-top:4px}.s42-pipeline .is-done{background:#EDF4EF;border-color:#B9CDBE}.s42-pipeline .is-done>span{background:#2C5A3A;color:#fff}.s42-pipeline .is-current{background:#FFF4E5;border:2px solid #C88927}.s42-pipeline .is-current>span{background:#C88927;color:#fff}.s42-quote-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}.s42-quote-card{background:#fff;border:1px solid #DDD5C9;border-radius:16px;padding:17px}.s42-quote-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.s42-quote-head>b{font-family:'Archivo';font-size:15px}.s42-quote-head span{font-family:'IBM Plex Mono';font-size:8.5px;border-radius:999px;padding:4px 6px}.s42-valid{background:#E9F2EC;color:#2C5A3A;border:1px solid #B9CDBE}.s42-pending{background:#F6F0E3;color:#8A5A12;border:1px solid #E4CAA0}.s42-quote-card>strong{display:block;font-family:'Instrument Sans',system-ui,sans-serif;font-size:26px;margin-top:18px}.s42-quote-card>small{display:block;font-size:9.5px;color:#756E64;margin-top:8px}.s42-empty-state{margin-top:18px;background:#1B1820;color:#F4F1EA;border-radius:16px;padding:20px}.s42-empty-state b{font-family:'Archivo';font-size:17px}.s42-empty-state p{font-size:12px;line-height:1.5;color:#CFC9BE;margin:6px 0 0}.s42-truth-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.s42-truth-grid>div{background:#fff;border-left:3px solid #E4002B;border-radius:12px;padding:13px}.s42-truth-grid span{font-size:10px;color:#756E64}.s42-truth-grid b{display:block;font-family:'Archivo';font-size:15px;margin-top:3px}
.s42-compare-wrap{background:#fff;border:1px solid #D7CEC2;border-radius:18px;overflow:hidden;margin-top:18px}.s42-compare-head,.s42-compare-row{display:grid;grid-template-columns:1.25fr 1fr 1fr}.s42-compare-head{background:#171419;color:#fff}.s42-compare-head>*{padding:13px 15px}.s42-compare-head span{font-family:'IBM Plex Mono';font-size:9px;color:#AAA29A;letter-spacing:.1em}.s42-compare-head b{font-family:'Archivo';font-size:13px}.s42-compare-row>*{padding:13px 15px;border-top:1px solid #E7E2D6}.s42-compare-row>span{font-size:11.5px;font-weight:650;color:#514A43;background:#F7F3EC}.s42-compare-row>div{font-family:'Archivo';font-size:13px}.s42-orientation{margin-top:14px;background:#0E0D10;color:#F4F1EA;border-radius:17px;padding:20px;border-left:4px solid #E4002B}.s42-orientation>span{font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.1em;color:#FF9DA8}.s42-orientation p{font-family:'Instrument Sans',system-ui,sans-serif;font-size:18px;font-style:italic;line-height:1.45;margin:8px 0}.s42-orientation small{font-size:10.5px;color:#AAA29A}.s42-decision-actions{display:grid;grid-template-columns:1.25fr .75fr .85fr;gap:10px;margin-top:14px}.s42-decision-actions button,.s42-no-compare button{min-height:48px;border-radius:12px;border:1px solid #D8D0C5;background:#F4F1EA;font:inherit;font-weight:700;cursor:pointer}.s42-decision-actions .primary{background:#E4002B;color:#fff;border-color:#E4002B}.s42-decision-actions .dark{background:#0E0D10;color:#fff;border-color:#0E0D10}.s42-no-compare{margin-top:18px;background:#161319;color:#F4F1EA;border-radius:18px;padding:24px}.s42-no-compare>span{font-family:'IBM Plex Mono';font-size:9px;color:#D1B8F3;letter-spacing:.1em}.s42-no-compare h4{font-family:'Archivo';font-size:20px;margin:8px 0}.s42-no-compare p{font-size:12.5px;line-height:1.55;color:#CFC9BE}.s42-no-compare button{margin-top:10px;background:#E4002B;color:#fff;border-color:#E4002B;padding:0 18px}
.s42-actions{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:22px;padding-top:18px;border-top:1px solid #DDD5C9}.s42-actions>div{display:flex;gap:8px}.s42-actions button{min-height:46px;padding:0 18px;border-radius:12px;font:inherit;font-weight:700;cursor:pointer}.s42-actions .secondary,.s42-actions .ghost{background:#fff;color:#12110F;border:1px solid #D8D0C5}.s42-actions .primary{background:#E4002B;color:#fff;border:1px solid #E4002B}.s42-proof{margin-top:18px;background:#111015;color:#F4F1EA;border-radius:18px;border:1px solid #2C2930;overflow:hidden}.s42-proof summary{cursor:pointer;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}.s42-proof summary span{font-family:'IBM Plex Mono';font-size:9.5px;letter-spacing:.11em;color:#FF9DA8}.s42-proof summary b{font-family:'Archivo';font-size:14px}.s42-proof-body{padding:0 18px 18px}.s42-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.s42-proof-grid>div{background:#1B1820;border:1px solid #302C35;border-radius:12px;padding:11px}.s42-proof-grid span{font-size:9px;color:#9F978F}.s42-proof-grid b{display:block;font-family:'IBM Plex Mono';font-size:10.5px;margin-top:4px;overflow-wrap:anywhere}.s42-proof-contracts{display:grid;gap:7px;margin-top:12px}.s42-proof-contracts>div{display:grid;grid-template-columns:120px 1fr 120px;gap:10px;background:#1B1820;border:1px solid #302C35;border-radius:10px;padding:10px}.s42-proof-contracts span{font-size:10px;color:#FF9DA8}.s42-proof-contracts b,.s42-proof-contracts code{font-size:9.5px;overflow-wrap:anywhere}.s42-proof-body>p{font-size:11px;line-height:1.55;color:#BDB5AD;margin:12px 0 0}
@media(max-width:980px){.s42-hero{grid-template-columns:1fr}.s42-shell{grid-template-columns:1fr}.s42-rail{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.s42-rail-title,.s42-rail-truth{grid-column:1/-1}.s42-route-grid{grid-template-columns:repeat(2,1fr)}.s42-quote-grid{grid-template-columns:1fr 1fr}.s42-stage-banner{grid-template-columns:auto 1fr}.s42-stage-context{grid-column:1/-1;align-items:flex-start;flex-direction:row;flex-wrap:wrap}.s42-proof-grid{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.s42-wrap{padding-left:14px;padding-right:14px}.s42-rail{grid-template-columns:1fr 1fr}.s42-stage-banner{padding:20px}.s42-stage-number{font-size:48px}.s42-stage-body{padding:18px}.s42-route-grid,.s42-form-grid,.s42-resolution-grid,.s42-contract-strip,.s42-pipeline,.s42-quote-grid,.s42-truth-grid,.s42-decision-actions,.s42-proof-grid{grid-template-columns:1fr}.s42-compare-head,.s42-compare-row{grid-template-columns:1.1fr .9fr .9fr}.s42-compare-head>*,.s42-compare-row>*{padding:10px 8px}.s42-actions{align-items:stretch;flex-direction:column}.s42-actions>div{display:grid;grid-template-columns:1fr 1fr}.s42-actions button{width:100%}.s42-proof-contracts>div{grid-template-columns:1fr}.s42-rail-truth{display:none}}
</style>


<style id="f7-s4-2-1-copy-nav-truth-fix">
.s42-rail-item{width:100%;text-align:left;font-family:inherit;cursor:pointer;background:transparent}.s42-rail-item:disabled{cursor:default;opacity:.62}.s42-rail-item b{line-height:1.2}.s42-rail-item>span{flex:0 0 30px}.s421-public-summary>div{min-height:70px}.s421-public-summary b{font-family:'Archivo';font-size:13px;line-height:1.35}.s42-proof{opacity:.96}.s42-stage-body .s42-country-note{margin-bottom:20px}.s42-empty-state b{font-family:'Archivo';font-size:18px}.s42-empty-state p{margin:6px 0 0;line-height:1.55}.s42-actions .secondary+ .secondary{background:#F8F5EF}.s42-truth-grid b{line-height:1.3}.s421-review-tag{margin:12px 0 16px;padding:10px 12px;border-radius:12px;background:#FFF3E5;border:1px solid #E8C38F;color:#73521F;font-size:11.5px;line-height:1.45}
