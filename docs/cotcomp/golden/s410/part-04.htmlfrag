  function proposalSet(country,product){
    const arr=((DEMO_QUOTES[country]||{})[product]||[]).map(x=>Object.assign({},x));
    return {quotes:arr,validated:arr.filter(x=>x.status==='VALIDATED'),pending:arr.filter(x=>x.status!=='VALIDATED')};
  }

  function compare(country,product,priority){
    const set=proposalSet(country,product); const q=set.validated;
    if(q.length<2) return {ok:false,reason:'comparativo_requiere_dos_cotizaciones_validadas',quotes:q,rankingPolicy:'NONE_BY_DEFAULT',noSilentWeighting:true};
    return {
      ok:true,
      reason:'VALIDATED_OPTIONS_AVAILABLE',
      quotes:q,
      selectedId:null,
      selectedName:null,
      ranking:null,
      priority:priority||'Balance costo/protección',
      rankingPolicy:'NONE_BY_DEFAULT',
      noSilentWeighting:true,
      explanation:'La prioridad organiza qué diferencias conviene revisar primero; no asigna puntajes ni selecciona una alternativa por el usuario.'
    };
  }

  const EXECUTION_CONTRACTS=Object.freeze({
    'gt:auto':Object.freeze({journeyId:'GT_AUTO_MOTO_HYBRID',status:'UX_FIELDS_ALIGNED_SOURCE_ONLY',backendQa:'PREIMPL 27/27 PASS · S4.10 tests authored',missingBeforeSubmit:['contact.name','contact.whatsapp','contact.email','consents.requestManagement']}),
    'gt:salud':Object.freeze({journeyId:'GT_GASTOS_MEDICOS_HYBRID',status:'UX_FIELDS_ALIGNED_SOURCE_ONLY',backendQa:'PREIMPL 27/27 PASS · S4.10 tests authored',missingBeforeSubmit:['contact.name','contact.whatsapp','contact.email','consents.requestManagement']}),
    'co:transporte':Object.freeze({journeyId:'CO_TRANSPORTE_CONSULTATIVE_HYBRID',status:'UX_FIELDS_ALIGNED_SOURCE_ONLY',backendQa:'PREIMPL 27/27 PASS · S4.10 tests authored',missingBeforeSubmit:['contact.name','contact.whatsapp','contact.email','consents.requestManagement']}),
    'co:empresa':Object.freeze({journeyId:'CO_RC_PROFESIONAL_CONSULTATIVE_HYBRID',status:'ROUTE_REQUIRES_EXPLICIT_RC_PROFESIONAL_SELECTION',backendQa:'27/27 PASS',missingBeforeSubmit:['needTrigger','applicantType','professionalActivity','contact.name','contact.whatsapp','contact.email','consents.requestManagement']})
  });
  function executionContract(country,product){
    return EXECUTION_CONTRACTS[String(country||'').toLowerCase()+':'+String(product||'').toLowerCase()]||{journeyId:null,status:'CONSULTATIVE_ONLY_NO_EXECUTABLE_PUBLIC_CONTRACT',backendQa:'N/A',missingBeforeSubmit:[]};
  }

  const proof={calls:[],last:null};
  function track(name,input,output){
    const rec={at:new Date().toISOString(),name,input:JSON.parse(JSON.stringify(input||{})),output:JSON.parse(JSON.stringify(output||{}))};
    proof.calls.push(rec); if(proof.calls.length>24) proof.calls.shift(); proof.last=rec; return output;
  }

  const api={
    version:'AYS_COTCOMP_SAFE_ADAPTER_LAB_v0.4_COMPLETION_ALIGNED',
    mode:'LAB_READONLY_NO_STORE',
    backend:BACKEND,
    resolveSchema:(country,product,form)=>track('resolveSchema',{country,product},schema(country,product,form)),
    evaluateEligibility:(country,product,form)=>track('evaluateEligibility',{country,product},eligibility(country,product,form)),
    proposalSet:(country,product)=>track('proposalSet',{country,product},proposalSet(country,product)),
    compare:(country,product,priority)=>track('compare',{country,product,priority},compare(country,product,priority)),
    executionContract:(country,product)=>track('executionContract',{country,product},executionContract(country,product)),
    proof:()=>({version:api.version,mode:api.mode,backend:BACKEND,executionContracts:EXECUTION_CONTRACTS,last:proof.last,calls:proof.calls.slice()})
  };
  root.AYSCotCompLab=api;
})(typeof window!=='undefined'?window:globalThis);
</script>

<style id="f7-r1-sc-interp-typography-transparent">
/* F7-R1: DataCanvas interpolation wrappers are typographically transparent.
   Prevent generic descendant selectors from turning semantic text into technical micro-label styling. */
.sc-interp.sc-interp.sc-interp.sc-interp.sc-interp:not(.sc-missing):not(.sc-unresolved){
  font-family:inherit !important;
  font-size:inherit !important;
  font-weight:inherit !important;
  font-style:inherit !important;
  line-height:inherit !important;
  letter-spacing:inherit !important;
  color:inherit !important;
  text-transform:inherit !important;
}
/* Keyboard skip-link must retain high contrast against its dark focus surface. */
.vl .vl-skip{color:#fff !important;}
.vl .vl-skip:hover,.vl .vl-skip:focus{color:#fff !important;}

  /* ===== OWNER REWORK RW1 · 2026-09-25 · visual-only, library-first ===== */
  .vl-emp-sit-card{isolation:isolate;}
  .vl-emp-sit-card::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:linear-gradient(180deg,#E4002B,#7B0B20);opacity:.92;}
  .vl-emp-sit-card:hover{transform:translateY(-3px)!important;box-shadow:0 28px 58px -38px rgba(30,10,0,.58)!important;border-color:#BFB3A3!important;}
  .vl-emp-sit-meta{display:flex;align-items:center;gap:9px;min-height:18px;}
  .vl-emp-sit-n{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.12em;color:#C4001F;}
  .vl-emp-sit-line{height:1px;width:24px;background:#D9D0C3;}
  .vl-emp-sit-status{font-family:'IBM Plex Mono',monospace;font-size:8.5px;letter-spacing:.1em;color:#C4001F;}
  .vl-emp-sit-title{display:block;font-family:'Archivo';font-weight:800;font-size:15.5px;letter-spacing:-.016em;color:#12110F;margin-top:12px;line-height:1.16;}
  .vl-emp-sit-desc{display:block;font-size:12.5px;line-height:1.5;color:#514A43;margin-top:7px;}
  .vl-emp-sit-arrow{position:absolute;right:16px;bottom:16px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#F4EFE6;color:#C4001F;font-weight:800;}
  .vl-emp-sit-card[aria-pressed="true"] .vl-emp-sit-arrow{background:#E4002B;color:#fff;}
  [data-country="gt"] .vl-egt-anchor{border-top-color:#3A333D;}
  [data-country="gt"] .vl-egt-anchor img{object-fit:cover!important;object-position:50% 50%!important;box-shadow:0 18px 44px -34px rgba(0,0,0,.88);}
  [data-country="co"] .vl-emp-heromedia img{aspect-ratio:4/3!important;object-position:52% 48%!important;}
  [data-country="co"] .vl-co-compmock{border-top:3px solid #E4002B!important;}
  .vl-comp-val{display:inline-flex;align-items:center;min-height:30px;padding:6px 8px;border-radius:9px;font-size:11.5px;line-height:1.25;font-weight:650;color:#2A2521;margin-right:8px;}
  .vl-comp-val-a{background:#F0E8DE;border:1px solid #D7CABB;}
  .vl-comp-val-b{background:#F7E9EC;border:1px solid #E7C3CB;}
  [data-country="co"] .vl-emp-cont > figure{background:#171318;}
  [data-country="co"] .vl-emp-cont > figure img{aspect-ratio:16/10!important;object-fit:cover!important;object-position:52% 50%!important;}
  @media(max-width:660px){
    .vl-emp-sit-card{min-height:118px!important;}
    .vl-comp-val{font-size:10.5px;padding:5px 6px;}
    [data-country="co"] .vl-emp-heromedia img{aspect-ratio:16/10!important;}
  }
</style>

