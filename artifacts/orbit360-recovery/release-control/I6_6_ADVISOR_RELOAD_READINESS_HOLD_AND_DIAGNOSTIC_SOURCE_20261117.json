itial={networkStarted:calls.length>0,settled,timersMs:timers.map(t=>t.ms),cacheLookups:matches.length};\n  for(const timer of [...timers])timer.fn();\n  await nextMicrotasks();\n  return {pathname,initial,afterAllOwnerTimers:{settled,cacheLookups:matches.length},network:calls};\n}\nfunction requirePromise(value){assert.ok(value&&typeof value.then==='function');}\nasync function main(){\n  const ownerContext={};ownerContext.window=ownerContext;\n  for(const key of ['document','navigator'])Object.defineProperty(ownerContext,key,{get(){throw new Error('UNEXPECTED_SYNCHRONOUS_'+key);}});\n  vm.createContext(ownerContext);\n  const ownerFiles=['core/product-runtime-browser-providers-p0.js','core/product-app-p0.js'];\n  const ownerEvidence=[];\n  for(const file of ownerFiles){const bytes=fs.readFileSync(path.join(root,'orbit360-platform',file));vm.runInContext(bytes.toString('utf8'),ownerContext,{filename:file});ownerEvidence.push({file,sha256:sha(bytes)});}\n  assert.equal(typeof ownerContext.Orbit.productRuntimeBrowserProvidersP0.initialize,'function');\n  assert.equal(typeof ownerContext.Orbit.productAppP0.activate,'function');\n  assert.equal(ownerContext.Orbit.productAppP0.status().started,false);\n  const rows=[];\n  for(const pathname of ['/core/product-runtime-browser-providers-p0.js','/core/product-app-p0.js','/styles/base.css','/core/access-role-session-owner-v20260728.js'])rows.push(await workerPending(pathname));\n  for(const row of rows.slice(0,3)){\n    assert.equal(row.initial.networkStarted,true);assert.deepEqual(row.initial.timersMs,[]);\n    assert.equal(row.afterAllOwnerTimers.settled,false);assert.equal(row.afterAllOwnerTimers.cacheLookups,0);\n  }\n  const bounded=rows[3];assert.deepEqual(bounded.initial.timersMs,[8000]);\n  assert.equal(bounded.afterAllOwnerTimers.settled,true);assert.ok(bounded.afterAllOwnerTimers.cacheLookups>0);\n  const result={status:'OFFLINE_MECHANISM_REPRODUCED_NOT_CI_ROOT_CAUSE',source:'fdbc65a59114d2858ce6884374eaf6c44d8ae9a